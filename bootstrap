# install hombrew
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
# add brew output to path
eval "$(/opt/homebrew/bin/brew shellenv)"
# install required brew packages
brew bundle --file ~/.config/Brewfile
# create root .zshrc symlink to .config/zsh/.zshrc
# NOTE: the targets are dotfiles (zsh/.zshrc), so the leading dot is required.
# ~/.zshenv is the load-bearing one: zsh reads it from $HOME before ZDOTDIR is
# set, and it is what points ZDOTDIR at ~/.config/zsh.
ln -sf "$HOME/.config/zsh/.zshrc" "$HOME/.zshrc"
# create root .zshenv symlink to .config/zsh/.zshenv
ln -sf "$HOME/.config/zsh/.zshenv" "$HOME/.zshenv"
zsh


link=https://github.com/raidel-a/dotfiles/releases/download/v1.1.0/MapleMonoNF-CN.zip
name=MapleMonoNF-CN.zip
echo "Downloading fonts..."
echo "${link}"
wget $link
echo "Unzipping Font: ${name}..."
unzip -o "$name" -d "$HOME/Library/Fonts"
rm -f "$name"
fc-cache -fv
echo "Downloaded and unzipped ${name}"
