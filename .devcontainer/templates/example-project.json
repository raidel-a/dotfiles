{
  "name": "my-project",
  "image": "ghcr.io/raidel-a/devcontainer-base:latest",
  
  // Mount the project workspace
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  
  // SSH server for WezTerm multiplexing
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  
  // SSH port mapping - IMPORTANT: Change this for each project!
  // Use 2222 for first project, 2223 for second, 2224 for third, etc.
  "runArgs": ["-p", "2222:2222"],
  
  // Mounts for SSH agent
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/home/vscode/.ssh/ssh-agent,type=bind"
  ],
  
  // Environment variables
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/home/vscode/.ssh/ssh-agent",
    "TZ": "America/New_York"
  },
  
  // Commands to run on container lifecycle
  "postCreateCommand": "echo 'Container created! Workspace mounted at /workspace'",
  "postStartCommand": "cd ~/.config && git pull --ff-only || true",
  
  // Run as vscode user (non-root)
  "remoteUser": "vscode"
}
