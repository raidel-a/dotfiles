# 
# Ghostty config - migrated from WezTerm
# 

# ---- Theme ----
theme = light:TokyoNight Day,dark:Ayu
# macos-icon = retro

# ---- Font ----
font-family = Maple Mono NF CN
font-family = Symbols Nerd Font
font-size = 15

# ---- Window ----
background-opacity = 0.87
macos-titlebar-style = tabs
window-padding-x = 0
window-padding-y = 3,0
window-inherit-working-directory = false
window-subtitle = working-directory

# ---- Tabs ----
tab-inherit-working-directory = false

# ---- Splits ----
unfocused-split-opacity = 0.3
split-divider-color = #444850


# ---- Cursor ----
cursor-style = bar

# ---- Mouse ----
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:1,discrete:1

# ---- Shell ----
shell-integration-features = ssh-env,ssh-terminfo

# =============================================================================
# Keybindings
# =============================================================================

# --- Split management ---
keybind = cmd+d=new_split:right
keybind = shift+cmd+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+n=new_window

# --- Quit / Hide ---
# keybind = cmd+m=toggle_visibility

# --- Pane navigation (vim-style) ---
# keybind = cmd+j=goto_split:down
# keybind = cmd+k=goto_split:up
# keybind = cmd+l=goto_split:right
# keybind = cmd+alt+h=goto_split:left

# --- Pane resize ---
keybind = shift+cmd+h=resize_split:left,20
keybind = shift+cmd+j=resize_split:down,20
keybind = shift+cmd+k=resize_split:up,20
keybind = shift+cmd+l=resize_split:right,20

# --- Pane select (no visual selector in Ghostty, use cycling) ---
keybind = cmd+,=goto_split:previous
keybind = cmd+.=goto_split:next

# --- Tabs ---
# keybind = cmd+t=new_tab
# keybind = ctrl+shift+tab=previous_tab
# keybind = ctrl+tab=next_tab
# keybind = shift+cmd+t=new_tab

# --- Font size ---
# keybind = cmd+equal=increase_font_size:1
# keybind = cmd+minus=decrease_font_size:1
# keybind = cmd+0=reset_font_size

# --- Fullscreen / Search ---
# keybind = cmd+f=toggle_fullscreen
keybind = shift+cmd+p=toggle_command_palette

# --- Config editing ---
keybind = cmd+shift+period=open_config

